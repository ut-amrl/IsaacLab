# OpenPI-specific environment variables
# This file is automatically sourced by container.py when using the openpi profile

# Disable PyTorch JIT compilation (avoids Triton MLIR errors on some GPUs)
PYTORCH_JIT=0
TORCH_COMPILE_DISABLE=1

# OpenPI virtual environment location (bind-mounted from host)
OPENPI_VENV=/root/.venv_cobot

# UV (Python package manager) configuration
UV_COMPILE_BYTECODE=1
UV_PROJECT_ENVIRONMENT=/root/.venv_cobot
UV_LINK_MODE=copy
GIT_LFS_SKIP_SMUDGE=1

# Docker name suffix (empty string for default naming)
DOCKER_NAME_SUFFIX=

# Isolate our ROS2 graph from other containers on this host (e.g. ecocar_robot's
# robot_static_tf is publishing world_to_base/base_to_camera/base_to_lidar on
# the default domain 0, which clobbers our TF tree).
ROS_DOMAIN_ID=42
